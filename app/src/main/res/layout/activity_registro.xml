<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_oscuro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:fontFamily="sans-serif">

        <TextView
            android:id="@+id/txtRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/titulo_registro"
            android:textColor="@color/texto_blanco"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_nombre"
            android:inputType="textPersonName"
            android:textColor="@color/texto_blanco"
            android:textColorHint="@color/texto_secundario"
            android:backgroundTint="@color/amarillo_boton"/>

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:textColor="@color/texto_blanco"
            android:textColorHint="@color/texto_secundario"
            android:backgroundTint="@color/amarillo_boton"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/pregunta_actividad"
            android:textColor="@color/texto_blanco"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <RadioGroup
            android:id="@+id/radioGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbCaminar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/amarillo_boton"
                android:text="@string/actividad_caminar"
                android:textColor="@color/texto_blanco"/>

            <RadioButton
                android:id="@+id/rbEstudiar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/amarillo_boton"
                android:text="@string/actividad_estudiar"
                android:textColor="@color/texto_blanco"/>

            <RadioButton
                android:id="@+id/rbLeer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/amarillo_boton"
                android:text="@string/actividad_leer"
                android:textColor="@color/texto_blanco"/>

            <RadioButton
                android:id="@+id/rbEjercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/amarillo_boton"
                android:text="@string/actividad_ejercicio"
                android:textColor="@color/texto_blanco"/>

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/titulo_preferencias"
            android:textColor="@color/texto_blanco"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <CheckBox
            android:id="@+id/cbRecordatorio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/amarillo_boton"
            android:text="@string/recordatorio"
            android:textColor="@color/texto_blanco"/>

        <CheckBox
            android:id="@+id/cbMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/amarillo_boton"
            android:text="@string/meta_semanal"
            android:textColor="@color/texto_blanco"/>

        <EditText
            android:id="@+id/etDiasMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_dias_meta"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="@color/texto_blanco"
            android:textColorHint="@color/texto_secundario"
            android:backgroundTint="@color/amarillo_boton"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnContinuar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/amarillo_boton"
            android:fontFamily="sans-serif-medium"
            android:text="@string/siguiente"
            android:textColor="@color/texto_blanco"/>

        <Button
            android:id="@+id/btnSalirRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/amarillo_boton"
            android:fontFamily="sans-serif-medium"
            android:text="@string/salir"
            android:textColor="@color/texto_blanco"/>

    </LinearLayout>
</ScrollView>